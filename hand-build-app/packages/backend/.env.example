CLIENT_ID=
CLIENT_SECRET=
# Issuer used to verify an app token in /verify-token.
# `npm run register` fills this in when the app has a frontend.
JTL_ISSUER=
# This app's id; /verify-token requires the token's `aud` to contain it. `npm run register` fills it in.
JTL_APP_ID=
# JTL API host. `npm run register` writes this. Default is
# JTL_API_BASE=https://api.jtl-cloud.com
# The service account mints its token at JTL_ISSUER + /oauth/v2/token; no extra config needed.
# Port the backend listens on (also what the frontend's VITE_BACKEND_URL points at).
PORT=3005
