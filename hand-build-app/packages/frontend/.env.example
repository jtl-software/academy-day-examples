# Browser login (public client, authorization code + PKCE).
# `npm run register` fills these in when the app declares a public client.
VITE_JTL_ISSUER=
VITE_JTL_CLIENT_ID=
# The JTL platform API, called directly from the browser by the serverless GraphQL demo.
# `npm run register` fills this in. Default is production.
# VITE_JTL_API_BASE=https://api.jtl-cloud.com
# Optional: override the requested scopes.
# VITE_JTL_SCOPE=openid profile email offline_access
# Set by `npm run register` when a node backend is present; enables the "verify token in backend"
# demo on the /login page.
# VITE_BACKEND_URL=http://localhost:3005
